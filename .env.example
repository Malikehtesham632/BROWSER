# Search providers
SERPER_API_KEY=
SERPAPI_API_KEY=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# SearXNG: free search without an API key.
# PRIVACY: when SearXNG is on, the text you search for is sent to the SearXNG servers listed
# here. If SEARXNG_INSTANCES is empty, Nova uses its built-in public fallback list.
# Public instances can rate-limit automated JSON/API traffic. For production, prefer a
# SearXNG instance you operate or explicitly trust.
# To keep every search private, set SEARXNG_ENABLED=false, or list only your own server.
# SEARXNG_ENABLED=true
# SEARXNG_INSTANCES=https://searx.tiekoetter.com,https://search.sapti.me,https://searx.work
SEARXNG_RETRIES=0
# WEIGHT_SEARXNG=0.8

# Engine tuning
PROVIDER_TIMEOUT_MS=4000
SCRAPE_TIMEOUT_MS=30000
CACHE_TTL_SECONDS=900
SCRAPE_CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=500

# HTTP API
PORT=8787
HOST=127.0.0.1
ALLOWED_ORIGINS=
OMNI_API_TOKEN=
RATE_LIMIT_PER_MINUTE=30

# Omni-owned crawl/index layer
OMNI_INDEX_FILE=data/omni-index.json
OMNI_FRONTIER_FILE=data/crawl-frontier.json
CRAWLER_TIMEOUT_MS=8000
CRAWLER_CONCURRENCY=4
CRAWLER_USER_AGENT=OmniBot/1.0
CRAWLER_DELAY_MS=1000
CRAWL_MAX_PAGES=25
CRAWL_MAX_DEPTH=2
CRAWL_ALLOW_EXTERNAL=false
WEIGHT_OMNI_INDEX=1.15

# Ranking: small boost for trusted domains (0 turns it off)
RANK_AUTHORITY_WEIGHT=0.04
# RANK_QUALITY_DOMAINS=docs.python.org,developer.mozilla.org

# Gemini is used only for query classification / expansion / benchmark generation.
GEMINI_API_KEY=
# gemini-2.5-flash is being shut down on 2026-10-16, so do not use it.
GEMINI_QUERY_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_OUTPUT_TOKENS=4000
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_BASE_MS=1000
GEMINI_MAX_RETRY_DELAY_MS=15000
GEMINI_BREAKER_THRESHOLD=3
GEMINI_BREAKER_COOLDOWN_MS=30000
GEMINI_CACHE_TTL_SECONDS=604800
GEMINI_CACHE_MAX_ENTRIES=2000
GEMINI_CACHE_FILE=data/gemini-query-cache.json
OMNI_QUERY_CORPUS_FILE=data/query-corpus.json

# Corpus evaluation
EVAL_CONCURRENCY=4
EVAL_CORPUS_LIMIT=1000
EVAL_CORPUS_RESULT_LIMIT=10
EVAL_CORPUS_FRESH=true
