{
  "name": "omni-engine",
  "version": "1.1.0",
  "private": true,
  "description": "Nova Browser, powered by Omni search.",
  "author": "Nova Browser",
  "main": "desktop/main.cjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "browser": "electron .",
    "build:win": "electron-builder --win nsis",
    "test": "node --test tests/*.test.js",
    "test:providers": "node tests/provider-test.js",
    "crawl": "node src/crawl-cli.js",
    "evaluate": "node src/eval/runner.js",
    "evaluate:custom": "node src/eval/runner.js",
    "evaluate:quick": "node src/eval/runner.js benchmark/queries.json 10",
    "evaluate:coverage": "node src/eval/runner.js benchmark/coverage.json 10",
    "evaluate:judged": "node src/eval/runner.js benchmark/judged.json 10",
    "evaluate:no-authority": "node src/eval/runner.js benchmark/queries.json 10 --no-authority",
    "evaluate:corpus": "node src/eval/corpus-runner.js",
    "crawl:frontier": "node src/frontier-cli.js",
    "crawl:recrawl": "node src/recrawl-cli.js",
    "query:add": "node src/query-cli.js add",
    "query:expand": "node src/query-cli.js expand",
    "query:smart": "node src/query-cli.js smart",
    "query:stats": "node src/query-cli.js stats",
    "query:list": "node src/query-cli.js list",
    "query:batch": "node src/query-batch-cli.js",
    "format": "npx prettier@3 --write \"src/**/*.js\" \"tests/**/*.js\" \"desktop/*.js\" \"desktop/*.cjs\"",
    "format:check": "npx prettier@3 --check \"src/**/*.js\" \"tests/**/*.js\" \"desktop/*.js\" \"desktop/*.cjs\""
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.nova.browser",
    "productName": "Nova Browser",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "src/**/*",
      "package.json",
      "!**/*.tmp",
      "!**/__tests__/**"
    ],
    "asar": true,
    "win": {
      "icon": "build/nova.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/nova.ico",
      "uninstallerIcon": "build/nova.ico",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp",
      "include": "installer/installer.nsh",
      "shortcutName": "Nova Browser",
      "menuCategory": "Nova Browser"
    },
    "publish": null
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Malikehtesham632/BROWSER.git"
  },
  "bugs": {
    "url": "https://github.com/Malikehtesham632/BROWSER/issues"
  },
  "homepage": "https://github.com/Malikehtesham632/BROWSER#readme"
}
